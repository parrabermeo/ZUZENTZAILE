# Gemini API Key (optional: can also be configured inside the app Settings modal)
VITE_GEMINI_API_KEY=

# Optional Firebase Firestore configuration
# If omitted or blocked by school network, the app automatically falls back to localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
